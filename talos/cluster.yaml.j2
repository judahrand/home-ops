---
version: v1alpha1
machine:
  ca:
    crt: op://kubernetes/talos/MACHINE_CA_CRT
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  token: op://kubernetes/talos/MACHINE_TOKEN
cluster:
  ca:
    crt: op://kubernetes/talos/CLUSTER_CA_CRT
  clusterName: main
  controlPlane:
    endpoint: https://k8s.judahrand.net:6443
  token: op://kubernetes/talos/CLUSTER_TOKEN
---
apiVersion: v1alpha1
kind: ResolverConfig
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true # Requires Cilium socketLB features
  resolveMemberNames: true
---
# Replaces machine.features.kubePrism. Drop the document to disable KubePrism.
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
# Replaces cluster.network. There is deliberately no KubeFlannelCNIConfig: the
# absence of that document is what makes cni.name "none" (Cilium is installed
# by Flux).
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.244.0.0/16
serviceSubnets:
  - 10.96.0.0/16
---
# Replaces cluster.discovery. Registration with the Kubernetes discovery
# registry is disabled by default in the multi-document model, which is what
# the old `registries.kubernetes.disabled: true` asked for.
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
# Replaces cluster.id + cluster.secret.
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: op://kubernetes/talos/CLUSTER_ID
clusterSecret: op://kubernetes/talos/CLUSTER_SECRET
---
# Replaces machine.kubelet (machine.kubelet.disableManifestsDirectory is locked
# to true in the multi-document model, so it is not set here).
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:v1.37.1
defaultRuntimeSeccompProfileEnabled: true
config:
  serializeImagePulls: false
  allowedUnsafeSysctls:
    - net.*
---
# Replaces machine.kubelet.nodeIP + machine.nodeLabels. The controlplane and
# per-node KubeNodeConfig documents deep-merge into this one.
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.0.42.0/24
labels:
  node.kubernetes.io/gpu: "true"
  topology.kubernetes.io/region: main
---
# Replaces machine.sysctls.
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 87380 33554432
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 33554432
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
  vm.nr_hugepages: "1024"
---
# Replaces the /etc/nfsmount.conf entry in machine.files.
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  nconnect=8
  noatime=True
  rsize=1048576
  wsize=1048576
---
# Replaces the /etc/cri/conf.d entry in machine.files.
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
# Replaces machine.kernel.modules.
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: thunderbolt
---
# Not present on upgraded clusters: enable it explicitly.
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.60
vlanID: 60
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.70
vlanID: 70
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: ExtensionServiceConfig
name: nut-client
configFiles:
  - content: |-
        MONITOR ups@nut.judahrand.net 1 upsmon "bacon" secondary
        SHUTDOWNCMD "/sbin/poweroff"
    mountPath: /usr/local/etc/nut/upsmon.conf
